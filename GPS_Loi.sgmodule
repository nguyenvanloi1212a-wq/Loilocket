#!name=iOS Location Spoofer (VanLoi206)
#!desc=Giả lập vị trí GPS sang nước Mỹ (New York) cho hệ điều hành iOS. Được cá nhân hóa bởi VanLoi206.
#!homepage=https://github.com/nguyenvanloi1212a-wq/Loilocket
#!author=VanLoi206

[Script]
Fake_GPS_Loi = type=http-response, pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$, requires-body=1, binary-body-mode=1, max-size=1048576, timeout=10, script-path=https://raw.githubusercontent.com/nguyenvanloi1212a-wq/Loilocket/refs/heads/main/gps_Loi.js, argument=mode=response&latitude=40.7580&longitude=-73.9855&horizontalAccuracy=39&verticalAccuracy=1000&altitude=530&debug=false

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
